# Copy to .env (git-ignored) and fill in. NEVER commit real keys, and never put them in a NEXT_PUBLIC_* variable.
# These are read ONLY by the Spring Boot backend; the browser never receives them.

# Twelve Data market data (https://twelvedata.com). Free "Basic" plan: 8 credits/minute, 800/day.
TWELVE_DATA_API_KEY=
# Set to true ONLY if your Twelve Data plan includes real-time data for these US stocks. Until then quotes are labelled "Delayed", never "Live".
MARKET_DATA_REALTIME_ENTITLED=false
TWELVE_DATA_CREDITS_PER_MINUTE=8

# Alpaca PAPER trading (simulated only, https://docs.alpaca.markets/us/docs/paper-trading). Use PAPER keys; leave empty to disable.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Generated by `bash scripts/setup-env.sh` (do NOT fill these by hand or commit real values) ---
# POSTGRES_PASSWORD, KC_BOOTSTRAP_ADMIN_PASSWORD and FINIX_SESSION_SECRET are random 256-bit values written to your git-ignored .env.
# Non-secret settings it also writes: POSTGRES_DB, POSTGRES_USER, KC_BOOTSTRAP_ADMIN_USERNAME, KEYCLOAK_REALM, KEYCLOAK_CLIENT_ID,
# SPRING_PROFILES_ACTIVE, JWT_ISSUER_URI, JWT_JWKS_URI, JWT_AUDIENCE, APP_ALLOWED_ORIGIN.
