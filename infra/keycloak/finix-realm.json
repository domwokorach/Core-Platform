{
  "realm": "finix",
  "enabled": true,
  "displayName": "FINIX Development",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "finix-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:3000" },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "finix-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "finix-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "username": "alex",
      "email": "alex@example.test",
      "firstName": "Alex",
      "lastName": "Morgan",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "DemoPass123!", "temporary": false }]
    }
  ]
}
