NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8081/realms/finix
NEXT_PUBLIC_OIDC_CLIENT_ID=finix-web
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Logo.dev PUBLISHABLE key (pk_...). Safe for the browser. Never use a secret key (sk_...) here. Leave empty to show neutral icons only.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
# Set to true ONLY with a real Visa issuer relationship or a Visa-authorised design demo. Requires the official assets in public/brand/ (visa-white.svg, visa-blue.svg) from Visa's brand centre.
NEXT_PUBLIC_VISA_BRANDING_APPROVED=false
# Opt-in unauthenticated sample-data mode for UI review/tests only. Leave unset: banking pages require sign-in.
# NEXT_PUBLIC_DEMO_MODE=true

# Development-only demo sign-in (demo@gmail.com). SERVER variable, honoured only by `next dev`; production builds ignore it.
# FINIX_DEMO_AUTH=true
